uniform float4x4 ViewProj;
uniform texture2d image;
uniform float input_scale;
uniform float output_scale;
uniform float method;
uniform float hdr_peak_nits;
uniform float sdr_peak_nits;
uniform float b_knee_nits;
uniform float b_strength_nits;
uniform float b_slope;
uniform float b_hlg_shaping;
uniform float b_input_lw_nits;
uniform float c_alpha;
uniform float c_k1;
uniform float c_k2;
uniform float c_k3;
uniform float c_k4;
uniform float c_knee_hdr_nits;
uniform float c_hdr_reference_white_nits;
uniform float c_white_shift;

sampler_state textureSampler {
	Filter = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv : TEXCOORD0;
};

struct VertOut {
	float2 uv : TEXCOORD0;
	float4 pos : POSITION;
};

struct FragData {
	float2 uv : TEXCOORD0;
};

VertOut VSDefault(VertData v_in)
{
	VertOut v_out;
	v_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	v_out.uv = v_in.uv;
	return v_out;
}

float3 rec709_to_rec2020(float3 v)
{
	return float3(
		dot(v, float3(0.6274038959, 0.3292830384, 0.0433130657)),
		dot(v, float3(0.0690972894, 0.9195403951, 0.0113623156)),
		dot(v, float3(0.0163914389, 0.0880133079, 0.8955952532)));
}

float3 rec2020_to_rec709(float3 v)
{
	return float3(
		dot(v, float3(1.6604910021, -0.5876411388, -0.0728498633)),
		dot(v, float3(-0.1245504745, 1.1328998971, -0.0083494226)),
		dot(v, float3(-0.0181507634, -0.1005788980, 1.1187296614)));
}

float3 pq_encode(float3 nits)
{
	float3 y = max(nits, 0.0) / 10000.0;
	float3 ym = pow(y, float3(0.1593017578125, 0.1593017578125, 0.1593017578125));
	float3 base = (0.8359375 + 18.8515625 * ym) / (1.0 + 18.6875 * ym);
	return pow(base, float3(78.84375, 78.84375, 78.84375));
}

float pq_decode_channel(float encoded)
{
	float e = pow(max(encoded, 0.0), 1.0 / 78.84375);
	float num = max(e - 0.8359375, 0.0);
	float den = max(18.8515625 - 18.6875 * e, 0.000001);
	return 10000.0 * pow(num / den, 1.0 / 0.1593017578125);
}

float3 rgb2020_to_lms(float3 c)
{
	return float3(1688.0 * c.r + 2146.0 * c.g + 262.0 * c.b,
		      683.0 * c.r + 2951.0 * c.g + 462.0 * c.b,
		      99.0 * c.r + 309.0 * c.g + 3688.0 * c.b) / 4096.0;
}

float3 lms_to_rgb2020(float3 c)
{
	return float3(3.43660669 * c.x - 2.50645212 * c.y + 0.06984542 * c.z,
		      -0.79132956 * c.x + 1.98360045 * c.y - 0.19227090 * c.z,
		      -0.02594990 * c.x - 0.09891371 * c.y + 1.12486361 * c.z);
}

float3 lms_prime_to_ictcp(float3 lp)
{
	return float3(0.5 * lp.x + 0.5 * lp.y,
		      (6610.0 * lp.x - 13613.0 * lp.y + 7003.0 * lp.z) / 4096.0,
		      (17933.0 * lp.x - 17390.0 * lp.y - 543.0 * lp.z) / 4096.0);
}

float3 ictcp_to_lms_prime(float3 v)
{
	return float3(v.x + 0.0086090370 * v.y + 0.1110296250 * v.z,
		      v.x - 0.0086090370 * v.y - 0.1110296250 * v.z,
		      v.x + 0.5600313357 * v.y - 0.3206271750 * v.z);
}

float3 ictcp_to_rgb2020_nits(float3 v)
{
	float3 lms_prime = ictcp_to_lms_prime(v);
	return lms_to_rgb2020(float3(pq_decode_channel(lms_prime.x), pq_decode_channel(lms_prime.y),
				     pq_decode_channel(lms_prime.z)));
}

float in_bt709_volume(float3 rgb2020_nits)
{
	float3 c = rec2020_to_rec709(rgb2020_nits) / max(sdr_peak_nits, 0.0001);
	return (c.r >= -0.0001 && c.g >= -0.0001 && c.b >= -0.0001 &&
		c.r <= 1.0001 && c.g <= 1.0001 && c.b <= 1.0001) ? 1.0 : 0.0;
}

float3 gamut_map_ictcp(float3 rgb2020_nits)
{
	// BT.2446-1 §5.2.4: desaturate out-of-volume colours in ICtCp, preserving I and hue.
	if (in_bt709_volume(rgb2020_nits) > 0.5)
		return rgb2020_nits;

	float3 ictcp = lms_prime_to_ictcp(pq_encode(rgb2020_to_lms(max(rgb2020_nits, 0.0))));
	float low = 0.0;
	float high = 1.0;
	float mid = 0.5;
	float3 candidate = float3(0.0, 0.0, 0.0);

	mid = 0.5 * (low + high);
	candidate = ictcp_to_rgb2020_nits(float3(ictcp.x, mid * ictcp.y, mid * ictcp.z));
	if (in_bt709_volume(candidate) > 0.5) low = mid; else high = mid;

	mid = 0.5 * (low + high);
	candidate = ictcp_to_rgb2020_nits(float3(ictcp.x, mid * ictcp.y, mid * ictcp.z));
	if (in_bt709_volume(candidate) > 0.5) low = mid; else high = mid;

	mid = 0.5 * (low + high);
	candidate = ictcp_to_rgb2020_nits(float3(ictcp.x, mid * ictcp.y, mid * ictcp.z));
	if (in_bt709_volume(candidate) > 0.5) low = mid; else high = mid;

	mid = 0.5 * (low + high);
	candidate = ictcp_to_rgb2020_nits(float3(ictcp.x, mid * ictcp.y, mid * ictcp.z));
	if (in_bt709_volume(candidate) > 0.5) low = mid; else high = mid;

	mid = 0.5 * (low + high);
	candidate = ictcp_to_rgb2020_nits(float3(ictcp.x, mid * ictcp.y, mid * ictcp.z));
	if (in_bt709_volume(candidate) > 0.5) low = mid; else high = mid;

	mid = 0.5 * (low + high);
	candidate = ictcp_to_rgb2020_nits(float3(ictcp.x, mid * ictcp.y, mid * ictcp.z));
	if (in_bt709_volume(candidate) > 0.5) low = mid; else high = mid;

	return ictcp_to_rgb2020_nits(float3(ictcp.x, low * ictcp.y, low * ictcp.z));
}

float hlg_system_gamma(float lw)
{
	return 1.2 + 0.42 * (log(max(lw, 1.0) / 1000.0) * 0.4342944819);
}

float3 hlg_shape_to_291(float3 light_nits)
{
	// BT.2446-1 §5.2.1: decode the HLG signal at Lw = 291 cd/m2 with gamma 1.03.
	float lw_in = max(b_input_lw_nits, 1.0);
	float y = dot(light_nits, float3(0.2627, 0.6780, 0.0593));
	if (y <= 0.0)
		return light_nits;

	float gamma_in = hlg_system_gamma(lw_in);
	float y_scene = pow(y / lw_in, 1.0 / gamma_in);
	float ratio = (291.0 / lw_in) * pow(max(y_scene, 0.00001), 1.03 - gamma_in);
	return light_nits * ratio;
}

float signed_power(float value, float exponent)
{
	return sign(value) * pow(abs(value), exponent);
}

float3 signed_power3(float3 value, float exponent)
{
	return float3(signed_power(value.r, exponent), signed_power(value.g, exponent), signed_power(value.b, exponent));
}

float map_method_a_luma(float y)
{
	// BT.2446-1 §4.1, Table 2: perceptual linearization, three-segment knee and inverse perceptual transform.
	float rho_hdr = 1.0 + 32.0 * pow(hdr_peak_nits / 10000.0, 1.0 / 2.4);
	float y_perceptual = log(1.0 + (rho_hdr - 1.0) * max(y, 0.0)) / log(rho_hdr);
	float y_compressed;
	if (y_perceptual <= 0.7399)
		y_compressed = 1.0770 * y_perceptual;
	else if (y_perceptual < 0.9909)
		y_compressed = -1.1510 * y_perceptual * y_perceptual + 2.7811 * y_perceptual - 0.6302;
	else
		y_compressed = 0.5 * y_perceptual + 0.5;

	float rho_sdr = 1.0 + 32.0 * pow(sdr_peak_nits / 10000.0, 1.0 / 2.4);
	return max((pow(rho_sdr, y_compressed) - 1.0) / (rho_sdr - 1.0), 0.0);
}

float3 map_method_a(float3 rgb2020)
{
	// BT.2446-1 §4.1, Table 3: preserve nonlinear chroma differences during luminance mapping.
	float3 signal = signed_power3(rgb2020, 1.0 / 2.4);
	float y_hdr = dot(signal, float3(0.2627, 0.6780, 0.0593));
	float y_sdr = map_method_a_luma(y_hdr);
	float cb = (signal.b - y_hdr) / 1.8814;
	float cr = (signal.r - y_hdr) / 1.4746;
	float scale = y_sdr / max(abs(1.1 * y_hdr), 0.00001);
	float cb_tmo = cb * scale;
	float cr_tmo = cr * scale;
	float y_tmo = y_sdr - max(0.1 * cr_tmo, 0.0);
	float3 nonlinear = float3(y_tmo + 1.4746 * cr_tmo,
				  y_tmo - 0.164553 * cb_tmo - 0.571353 * cr_tmo,
				  y_tmo + 1.8814 * cb_tmo);
	return nonlinear;
}

float3 map_method_b(float3 rgb2020_nits)
{
	// BT.2446-1 §5.2.1: Method B is defined on the HLG signal decoded at Lw = 291 cd/m2.
	float3 light_nits = b_hlg_shaping > 0.5 ? hlg_shape_to_291(rgb2020_nits) : rgb2020_nits;

	// §5.2.2–§5.2.3: scale luminance only (chroma is unchanged), 1:1 below the knee.
	float y = dot(light_nits, float3(0.2627, 0.6780, 0.0593));
	float knee = max(b_knee_nits, 0.0001);
	float strength = max(b_strength_nits, 0.0001);
	float slope = max(b_slope, 0.0001);
	float y_pos = max(y, 0.0);
	float mapped_y = y_pos <= knee ? y_pos : knee + strength / slope * log(1.0 + slope * (y_pos - knee) / strength);
	float scale = y > 0.0001 ? mapped_y / y : 1.0;

	// §5.2.4: hard-clip to the BT.709 volume by hue-preserving desaturation in ICtCp.
	float3 mapped2020_nits = gamut_map_ictcp(light_nits * scale);
	return saturate(mapped2020_nits / max(sdr_peak_nits, 0.0001));
}

float3 crosstalk(float3 rgb, float alpha)
{
	return float3((1.0 - 2.0 * alpha) * rgb.r + alpha * rgb.g + alpha * rgb.b,
		      alpha * rgb.r + (1.0 - 2.0 * alpha) * rgb.g + alpha * rgb.b,
		      alpha * rgb.r + alpha * rgb.g + (1.0 - 2.0 * alpha) * rgb.b);
}

float lab_f(float value)
{
	float delta = 6.0 / 29.0;
	float delta3 = delta * delta * delta;
	return value > delta3 ? pow(value, 1.0 / 3.0) : value / (3.0 * delta * delta) + 4.0 / 29.0;
}

float lab_f_inverse(float value)
{
	float delta = 6.0 / 29.0;
	return value > delta ? value * value * value : 3.0 * delta * delta * (value - 4.0 / 29.0);
}

float3 inverse_crosstalk(float3 rgb, float alpha)
{
	float mean = (rgb.r + rgb.g + rgb.b) / 3.0;
	return (rgb - mean) / max(1.0 - 3.0 * alpha, 0.01) + mean;
}

float3 map_method_c(float3 rgb2020)
{
	// BT.2446-1 §6.1.2–§6.1.7: crosstalk, Yxy luminance knee, inverse matrix and SDR EOTF.
	float3 rgb_x = crosstalk(rgb2020 * hdr_peak_nits, c_alpha);
	float3 xyz = float3(dot(rgb_x, float3(0.6370, 0.1446, 0.1689)),
			    dot(rgb_x, float3(0.2627, 0.6780, 0.0593)),
			    dot(rgb_x, float3(0.0000, 0.0281, 1.0610)));
	float sum = xyz.x + xyz.y + xyz.z;
	if (xyz.y <= 0.0 || sum <= 0.00001)
		return rgb2020 * c_k1 * hdr_peak_nits / 100.0;
	float2 xy = float2(xyz.x, xyz.y) / sum;

	if (c_white_shift > 0.0 && xyz.y > c_hdr_reference_white_nits) {
		// BT.2446-1 §6.1.8: optionally reduce highlight chroma in CIE L*a*b* above HDR reference white.
		float3 white = float3(c_hdr_reference_white_nits * 192.93 / 203.0,
				      c_hdr_reference_white_nits,
				      c_hdr_reference_white_nits * 221.05 / 203.0);
		float fx = lab_f(xyz.x / white.x);
		float fy = lab_f(xyz.y / white.y);
		float fz = lab_f(xyz.z / white.z);
		float lightness = 116.0 * fy - 16.0;
		float peak_lightness = max(116.0 * lab_f(hdr_peak_nits / max(c_hdr_reference_white_nits, 0.0001)) - 16.0,
				   100.0001);
		float correction = saturate(c_white_shift * saturate((lightness - 100.0) / (peak_lightness - 100.0)));
		float a = 500.0 * (fx - fy) * (1.0 - correction);
		float b = 200.0 * (fy - fz) * (1.0 - correction);
		xyz.x = lab_f_inverse(fy + a / 500.0) * white.x;
		xyz.z = lab_f_inverse(fy - b / 200.0) * white.z;
		sum = xyz.x + xyz.y + xyz.z;
		xy = float2(xyz.x, xyz.y) / max(sum, 0.00001);
	}

	float mapped_y = xyz.y < c_knee_hdr_nits ? c_k1 * xyz.y
		: c_k2 * log(max(xyz.y / c_knee_hdr_nits - c_k3, 0.0001)) + c_k4;
	float3 xyz_sdr = float3(xy.x / max(xy.y, 0.00001) * mapped_y,
				mapped_y,
				(1.0 - xy.x - xy.y) / max(xy.y, 0.00001) * mapped_y);
	float3 rgb_sdr = float3(
		dot(xyz_sdr, float3(1.7167, -0.3557, -0.2534)),
		dot(xyz_sdr, float3(-0.6667, 1.6165, 0.0158)),
		dot(xyz_sdr, float3(0.0176, -0.0428, 0.9421)));
	return inverse_crosstalk(rgb_sdr, c_alpha) / 100.0;
}

float4 PSDefault(FragData f_in) : TARGET
{
	float4 rgba = image.Sample(textureSampler, f_in.uv);
	float3 source_nits = rgba.rgb * input_scale;
	float3 linear2020 = rec709_to_rec2020(source_nits);
	float3 normalized2020 = linear2020 / max(hdr_peak_nits, 0.0001);
	float3 result2020;
	if (method < 0.5) {
		float3 nonlinear_sdr = map_method_a(normalized2020);
		result2020 = signed_power3(nonlinear_sdr, 2.4) * sdr_peak_nits;
	} else if (method < 1.5) {
		result2020 = map_method_b(linear2020) * sdr_peak_nits;
	} else {
		result2020 = map_method_c(normalized2020) * sdr_peak_nits;
	}
	// Write the result in the convention of the target space (1.0 = the target's
	// white level) so the compositor can treat the source as plain SDR.
	float3 result_target = rec2020_to_rec709(result2020) * output_scale;
	return float4(result_target, rgba.a);
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader = PSDefault(f_in);
	}
}
